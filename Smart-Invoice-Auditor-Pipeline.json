    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.text;\n\n// تنظيف النص وتحويله إلى كائن JSON\nlet cleanText = raw.replace(/```json/g, '').replace(/```/g, '').trim();\nlet invoice = JSON.parse(cleanText);\n\n// التدقيق الحسابي للبنود والضرائب\nlet itemsSum = 0;\nlet errors = [];\n\nif (Array.isArray(invoice.items)) {\n  for (const item of invoice.items) {\n    let expected = Number((item.quantity * item.unit_price).toFixed(2));\n    if (Math.abs(expected - item.total) > 0.01) {\n      errors.push(`خطأ في بند ${item.description}: المتوقع ${expected} والمكتوب ${item.total}`);\n    }\n    itemsSum += item.total;\n  }\n}\n\nitemsSum = Number(itemsSum.toFixed(2));\nlet expectedTotal = Number((invoice.subtotal + invoice.tax_amount).toFixed(2));\n\nif (Math.abs(itemsSum - invoice.subtotal) > 0.01) {\n  errors.push(`خطأ في المجموع الفرعي: مجموع البنود ${itemsSum} والمذكور ${invoice.subtotal}`);\n}\n\nif (Math.abs(expectedTotal - invoice.total_amount) > 0.01) {\n  errors.push(`خطأ في الإجمالي الكلي: المتوقع ${expectedTotal} والمذكور ${invoice.total_amount}`);\n}\n\n// النتيجة النهائية مع حالة التدقيق\nreturn [{\n  json: {\n    ...invoice,\n    is_valid: errors.length === 0,\n    validation_errors: errors\n  }\n}];"
      },
